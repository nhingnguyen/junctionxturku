{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junctionxturku.local/schemas/risk-profile-v2.schema.json",
  "title": "Parcel Risk Dataset v2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source_snapshot",
    "metadata",
    "source_catalog",
    "parcels"
  ],
  "properties": {
    "schema_version": { "const": "2.1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_snapshot": { "type": "object" },
    "metadata": { "type": "object" },
    "source_catalog": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["publisher", "dataset", "license"]
      }
    },
    "parcels": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parcel" }
    }
  },
  "$defs": {
    "parcel": {
      "type": "object",
      "required": [
        "kiinteistotunnus",
        "text_format",
        "official_addresses",
        "postal_code",
        "coordinates_wgs84",
        "total_buildings",
        "total_floor_area_sqm",
        "risk_profile"
      ],
      "properties": {
        "kiinteistotunnus": { "type": "string", "pattern": "^\\d{14}$" },
        "text_format": { "type": "string" },
        "official_addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "postal_code": { "type": "string", "pattern": "^\\d{5}$" },
        "coordinates_wgs84": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "total_buildings": { "type": "number", "minimum": 0 },
        "total_floor_area_sqm": { "type": "number", "minimum": 0 },
        "risk_profile": {
          "type": "object",
          "required": ["static", "periodic", "live"],
          "properties": {
            "static": { "$ref": "#/$defs/factorGroup" },
            "periodic": { "$ref": "#/$defs/factorGroup" },
            "live": { "$ref": "#/$defs/factorGroup" }
          }
        }
      }
    },
    "factorGroup": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/factor" }
    },
    "factor": {
      "type": "object",
      "required": ["data", "scope", "source", "as_of", "method", "freshness"],
      "properties": {
        "data": { "type": "object" },
        "scope": {
          "type": "object",
          "required": ["level", "spatial_basis", "inherited_from"]
        },
        "source": {
          "type": "object",
          "required": ["refs"],
          "properties": {
            "refs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "as_of": { "type": ["string", "null"] },
        "method": { "type": "string", "minLength": 1 },
        "freshness": {
          "type": "object",
          "required": [
            "cadence",
            "status",
            "usable_for_current_state",
            "refresh_policy",
            "caveat"
          ],
          "properties": {
            "cadence": { "enum": ["static", "periodic", "live"] },
            "status": { "type": "string" },
            "usable_for_current_state": { "type": "boolean" },
            "refresh_policy": { "type": "string" },
            "caveat": { "type": "string" }
          }
        },
        "aggregation": {
          "type": "object",
          "required": [
            "strategy",
            "input_building_count",
            "usable_for_building_specific_claim",
            "caveat"
          ],
          "properties": {
            "strategy": { "type": "string" },
            "input_building_count": { "type": "number", "minimum": 0 },
            "usable_for_building_specific_claim": { "type": "boolean" },
            "caveat": { "type": "string" }
          }
        },
        "legacy_data": { "type": "object" },
        "legacy_data_status": { "type": "string" }
      }
    }
  }
}
